# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Linear webhook signing secret (Settings → API → Webhooks)
LINEAR_WEBHOOK_SECRET=

# Anthropic API key for Claude managed agents
ANTHROPIC_API_KEY=

# API key for event-log endpoints (generate a random string)
API_KEY=

# Auto-set by Vercel — used for callback URL
# VERCEL_URL=

# Vercel Cron secret (auto-set by Vercel on Pro plan)
# CRON_SECRET=

# ─── Managed Agent IDs (from scripts/setup-agents.ts) ───
AGENT_ID_SAGA=
AGENT_ID_ATLAS=
AGENT_ID_PIXEL=
AGENT_ID_SPRITE=
AGENT_ID_BYTE=
AGENT_ID_LOOP=
AGENT_ID_SCOUT=

# ─── Environment IDs (from scripts/setup-agents.ts) ───
ENV_ID_PLANNING=
ENV_ID_DEVELOPMENT=
